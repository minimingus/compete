{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/projects", "destination": "/api" },
    { "source": "/projects/:path*", "destination": "/api" },
    { "source": "/competitors/:path*", "destination": "/api" },
    { "source": "/monitoring/:path*", "destination": "/api" },
    { "source": "/pages/:path*", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/monitoring/run",
      "schedule": "0 6 * * *"
    }
  ]
}
