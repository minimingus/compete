# Neon Postgres — pooled connection string (used at runtime)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/competitor_monitor?sslmode=require"
# Neon Postgres — direct connection string (used for migrations)
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/competitor_monitor?sslmode=require"

# Redis (for BullMQ — needed for worker process, not used in Vercel serverless)
REDIS_URL="redis://localhost:6379"

# Server (standalone mode only, not used on Vercel)
PORT=3000
HOST=0.0.0.0

# Vercel Cron secret (set in Vercel dashboard → Settings → Environment Variables)
# CRON_SECRET=

# Monitoring
CHANGE_SCORE_THRESHOLD=0.05

# Email (stub in v1 — fill in for real notifications)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
ALERT_FROM_EMAIL=alerts@competitor-monitor.local
